# Optional server-only Gemini API key for photo matching.
GEMINI_API_KEY=
# Optional stable Gemini multimodal model. The implementation defaults safely.
GEMINI_MODEL=gemini-2.5-flash
# Optional approved stable production origin. Never use a Preview URL permanently.
SITE_URL=
# Explicit opt-in only after brand/content/indexing approval.
DRIVELENS_PUBLIC_INDEXING=false
